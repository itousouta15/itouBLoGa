<footer id="footer" aria-label="Site footer">
  <div class="footer-line-wrap">
    <div class="footer-line"></div>
  </div>

  <div class="footer-inner">
    <%_ if (theme.copyright) { _%>
      <%- render(theme.copyright, 'html'); %>
    <%_ } _%>

    <nav class="footer-projects" aria-label="My Projects">
      <div class="footer-section-label">My Projects</div>
      <div class="footer-project-links">
        <a href="https://itousouta15.tw" target="_blank" rel="noopener nofollow noreferrer">itouSouta</a>
        <a href="https://links.itousouta15.tw" target="_blank" rel="noopener nofollow noreferrer">itouLinks</a>
        <a href="https://slides.itousouta15.tw/" target="_blank" rel="noopener nofollow noreferrer">itouSlides</a>
        <a href="https://cards.itousouta15.tw/" target="_blank" rel="noopener nofollow noreferrer">itouCards</a>
        <a href="https://blog.itousouta15.tw/" target="_blank" rel="noopener nofollow noreferrer">itouBLoGa</a>
      </div>
    </nav>

    <div class="footer-divider"></div>
    <div class="footer-section-label">Social Media</div>
    <div class="footer-socials" aria-label="Social links">
      <a class="footer-si si-instagram" href="https://www.instagram.com/itou.souta15" target="_blank" rel="noopener nofollow noreferrer" aria-label="Instagram">
        <span class="footer-si-icon"></span>
      </a>
      <a class="footer-si si-github" href="https://github.com/itousouta15" target="_blank" rel="noopener nofollow noreferrer" aria-label="GitHub">
        <span class="footer-si-icon"></span>
      </a>
      <a class="footer-si si-x" href="https://x.com/itou_souta15" target="_blank" rel="noopener nofollow noreferrer" aria-label="X">
        <span class="footer-si-icon"></span>
      </a>
      <a class="footer-si si-discord" href="https://DC.itousouta15.tw" target="_blank" rel="noopener nofollow noreferrer" aria-label="Discord">
        <span class="footer-si-icon"></span>
      </a>
      <a class="footer-si si-telegram" href="https://t.me/itousouta15" target="_blank" rel="noopener nofollow noreferrer" aria-label="Telegram">
        <span class="footer-si-icon"></span>
      </a>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <span class="icon-copyright"></span>
        <%_ const currentYear = new Date().getFullYear(); _%>
        <%_ const sinceYear = parseInt(theme.footer.since, 10); _%>
        <%_ if (sinceYear === currentYear) { _%>
          <%= sinceYear %>
        <%_ } else { _%>
          <%= sinceYear %>–<%= currentYear %>
        <%_ } _%>
        <span class="footer-heart">♥</span>
        <span>itouSouta</span>
      </div>

      <%_ if (theme.footer.powered) { _%>
      <div class="footer-powered">
        Powered by <a href="https://hexo.io/" rel="noopener nofollow noreferrer" target="_blank">Hexo</a>
        &nbsp;·&nbsp;
        Theme <a href="https://github.com/D-Sketon/hexo-theme-reimu" rel="noopener nofollow noreferrer" target="_blank">Reimu</a>
      </div>
      <%_ } _%>

      <%_ if (theme.footer.count) { _%>
      <div class="footer-stats">
        <span class="icon-brush"></span>&nbsp;<%= totalcount() %>&nbsp;·&nbsp;<span class="icon-coffee"></span>&nbsp;<%= totalmin2read() %>
      </div>
      <%_ } _%>

      <%_ if (theme.icp.icpnumber) { _%>
      <div class="footer-beian">
        <a target="_blank" rel="noopener nofollow noreferrer" href="https://beian.miit.gov.cn"><%= theme.icp.icpnumber %></a>
      </div>
      <%_ } _%>

      <%_ if (theme.icp.beian && theme.icp.recordcode) { _%>
      <div class="footer-beian">
        <img style="object-fit: contain;margin-right: 2px;" src="data:image/png;base64," alt="">
        <a target="_blank" rel="noopener nofollow noreferrer" href="https://beian.mps.gov.cn/#/query/webSearch?code=<%= theme.icp.recordcode %>"><%= theme.icp.beian %></a>
      </div>
      <%_ } _%>

      <%_ if (theme.moe_icp.icpnumber) { _%>
      <div class="footer-beian">
        <img style="object-fit: contain;margin-right: 2px;" src="https://icp.gov.moe/images/ico64.png" alt="" width="24" height="24" />
        <a target="_blank" rel="noopener nofollow noreferrer" href="https://icp.gov.moe/?keyword=<%= theme.moe_icp.icpnumber %>">萌ICP备<%= theme.moe_icp.icpnumber %>号</a>
      </div>
      <%_ } _%>

      <%_ if (theme.footer.busuanzi) { _%>
      <div class="footer-stats">
        <span class="icon-eye"></span>&nbsp;<span id="busuanzi_container_site_pv"><%= __('busuanzi.pv') %>&nbsp;<span id="busuanzi_value_site_pv"></span></span>
        &nbsp;·&nbsp;
        <span class="icon-user"></span>&nbsp;<span id="busuanzi_container_site_uv"><%= __('busuanzi.uv') %>&nbsp;<span id="busuanzi_value_site_uv"></span></span>
      </div>
      <%_ } _%>
    </div>
  </div>
</footer>
